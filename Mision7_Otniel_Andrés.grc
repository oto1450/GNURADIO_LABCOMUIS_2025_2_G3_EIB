- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='Potencia promedio',\n            in_sig=[(np.complex64, 512)],\n\
      \            out_sig=[np.float32]\n        )\n\n    def work(self, input_items,\
      \ output_items):\n        x = input_items[0]  # x tiene forma [N, 1024]\n  \
      \      N = 1024\n\n        # Potencia promedio expl\xEDcita: (1/N) * sum(|x[n]|^2)\n\
      \        power = (1.0 / N) * np.sum(np.abs(x)**2, axis=1)\n\n        output_items[0][:]\
      \ = power.astype(np.float32)\n        return len(output_items[0])\n\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Potencia promedio', 'blk', [], [('0', 'complex', 512)], [('0', 'float',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 384.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Bloque para calcular media y desviaci\xF3n est\xE1ndar de la amplitud\"\
      \"\"\n\n    def __init__(self):\n        gr.sync_block.__init__(\n         \
      \   self,\n            name=\"Estad\xEDsticas de Amplitud\",\n            in_sig=[(np.complex64,\
      \ 512)],  # entrada: vector complejo (longitud configurable)\n            out_sig=[np.float32,\
      \ np.float32]  # salidas: media y desviaci\xF3n est\xE1ndar\n        )\n\n \
      \   def work(self, input_items, output_items):\n        in0 = input_items[0]\
      \  # forma: (N, 1024)\n        mean_out = output_items[0]\n        std_out =\
      \ output_items[1]\n\n        for i, vec in enumerate(in0):\n            # Calcular\
      \ magnitudes\n            magnitudes = np.abs(vec)\n\n            # Media de\
      \ amplitud\n            mean_amp = np.mean(magnitudes)\n\n            # Desviaci\xF3\
      n est\xE1ndar de amplitud\n            std_amp = np.std(magnitudes)\n\n    \
      \        # Asignar resultados a las salidas\n            mean_out[i] = mean_amp\n\
      \            std_out[i] = std_amp\n\n        # Retornar el n\xFAmero de elementos\
      \ producidos\n        return len(mean_out)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: "('Estad\xEDsticas de Amplitud', 'blk', [], [('0', 'complex', 512)],\
      \ [('0', 'float', 1), ('1', 'float', 1)], 'Bloque para calcular media y desviaci\xF3\
      n est\xE1ndar de la amplitud', [])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 464.0]
    rotation: 0
    state: enabled
